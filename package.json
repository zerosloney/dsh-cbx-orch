{
  "name": "dsh-cbx-orch",
  "version": "0.5.1",
  "description": "Durable coding-agent orchestrator as a DeepSeek Harness plugin: dispatch tasks to codebuddy/opencode/omp/cline/qwen with persistent jobs, queue, review, and rollback.",
  "license": "MIT",
  "type": "module",
  "files": [
    "lib/",
    "ui/",
    "cordis.patch.yml",
    "README.md"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./web": {
      "types": "./lib/web-plugin.d.ts",
      "default": "./lib/web-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=4",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run check",
    "preversion": "npm run check",
    "release": "node scripts/bash.mjs scripts/release.sh",
    "smoke:e2e": "node scripts/bash.mjs smoke/e2e.sh",
    "smoke:pack": "node scripts/bash.mjs smoke/pack.sh"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "better-sqlite3": "^12.11.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
